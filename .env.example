NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_NAME=MUTAN Cooperative
NEXT_PUBLIC_ADMIN_WHATSAPP=2348000000000

# Paystack PUBLIC key only — safe to expose client-side, used by the
# "Pay Direct" inline checkout widget. The SECRET key lives only in the
# backend's .env and must never appear here.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
